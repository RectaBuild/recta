{
  "name": "@recta/mcp",
  "version": "0.1.13",
  "mcpName": "io.github.RectaBuild/recta",
  "description": "Local MCP server for Recta (api.recta.build): lets any MCP agent evaluate, authorize and execute cheaper cross-chain stablecoin routes with its own key, which never leaves the machine. Also a MetaMask Agent Wallet (mm) plugin: mm recta move.",
  "license": "MIT",
  "author": "Recta (https://recta.build)",
  "homepage": "https://github.com/RectaBuild/recta/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RectaBuild/recta.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/RectaBuild/recta/issues"
  },
  "keywords": [
    "recta",
    "mcp",
    "ai-agent",
    "cross-chain",
    "bridge",
    "stablecoin",
    "usdc",
    "agentkit",
    "coinbase-agentkit",
    "goat-sdk",
    "elizaos",
    "metamask",
    "metamask-agent-wallet",
    "oclif-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "recta-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agentkit": {
      "types": "./dist/agentkit.d.ts",
      "import": "./dist/agentkit.js"
    },
    "./goat": {
      "types": "./dist/goat.d.ts",
      "import": "./dist/goat.js"
    },
    "./metamask": {
      "types": "./dist/metamask.d.ts",
      "import": "./dist/metamask.js"
    },
    "./elizaos": {
      "types": "./dist/elizaos.d.ts",
      "import": "./dist/elizaos.js"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mm-manifest.mjs"
  },
  "dependencies": {
    "@recta/client": "0.1.7",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "zod": "^3.22.4 || ^4.0.0",
    "@metamask/agent-wallet": "^7.3.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@metamask/agent-wallet": {
      "optional": true
    }
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/mm/commands"
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^7.3.0",
    "capabilities": [],
    "commands": [
      {
        "id": "recta:fit",
        "capabilities": [],
        "dataAccess": [],
        "targetChains": "any"
      },
      {
        "id": "recta:trial",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": "any"
      },
      {
        "id": "recta:move",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts",
          "balances"
        ],
        "targetChains": [
          1,
          10,
          56,
          130,
          137,
          143,
          999,
          5042,
          8453,
          42161,
          43114,
          57073,
          59144
        ]
      },
      {
        "id": "recta:report",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          8453
        ]
      },
      {
        "id": "recta:ledger",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          8453
        ]
      },
      {
        "id": "recta:fee-funds",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts",
          "balances"
        ],
        "targetChains": [
          8453
        ]
      },
      {
        "id": "recta:approve-fee",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts",
          "balances"
        ],
        "targetChains": [
          8453
        ]
      },
      {
        "id": "recta:pay-debt",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts",
          "balances"
        ],
        "targetChains": [
          8453
        ]
      },
      {
        "id": "recta:recover",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": "any"
      }
    ]
  }
}
